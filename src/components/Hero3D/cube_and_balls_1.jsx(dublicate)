            </group>
            <group position={[125.015, -199.858, 0]} rotation={[0, 0, -Math.PI / 2]}>
              <mesh ref={(el) => (sphereRefs.current[10] = el)} castShadow receiveShadow geometry={nodes.Sphere_10.geometry} material={sphereMaterial} position={[-400.206, 0, 0]} rotation={[-Math.PI / 2, 0, 0]} />
            </group>
            <group position={[199.858, 125.015, 0]}>
              <mesh ref={(el) => (sphereRefs.current[11] = el)} castShadow receiveShadow geometry={nodes.Sphere_11.geometry} material={sphereMaterial} position={[-400.206, 0, 0]} rotation={[-Math.PI / 2, 0, 0]} />
            </group>
          </group>
        </group>
      </group>
    </group>
  )
}

useGLTF.preload('/cube_and_balls.glb')
