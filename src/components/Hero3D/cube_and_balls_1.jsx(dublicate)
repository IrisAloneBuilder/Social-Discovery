import React, { useRef } from 'react'
import { useGLTF } from '@react-three/drei'
import { useFrame } from '@react-three/fiber'
import * as THREE from 'three'

// Dark, reflective metallic materials matching your original scene
const sphereMaterial = new THREE.MeshPhysicalMaterial({
  color: '#050505',
  metalness: 1.0,
  roughness: 0.05,
  envMapIntensity: 1.5,
})

const cubeMaterial = new THREE.MeshStandardMaterial({
  color: '#0a0a0a',
  metalness: 0.9,
  roughness: 0.1,
  side: THREE.DoubleSide,
})

export function Model(props) {
  const { nodes } = useGLTF('/cube_and_balls.glb')
  
  // Create an array to hold references to the actual rendered meshes
  const sphereRefs = useRef([])

  useFrame((state) => {
    const t = state.clock.getElapsedTime()

    // Loop through the rendered meshes to animate them
    sphereRefs.current.forEach((sphere, index) => {
      if (sphere) {
        sphere.position.x = -400.206 + Math.sin(t * 2 + index * 0.5) * 60
      }
    })
  })

  return (
    <group {...props} dispose={null}>
      <group scale={0.01}>
        <group position={[-5.494, 18.018, 0]}>
          <group position={[0, 0, -0.327]} rotation={[-0.686, -0.418, -2.682]}>
            <group rotation={[-Math.PI / 2, Math.PI / 2, 0]}>
              <group position={[-125.015, 199.858, 0]} rotation={[0, 0, Math.PI / 2]}>
                <mesh ref={(el) => (sphereRefs.current[0] = el)} castShadow receiveShadow geometry={nodes.Sphere.geometry} material={sphereMaterial} position={[-400.206, 0, 0]} rotation={[-Math.PI / 2, 0, 0]} />
              </group>
              <group position={[-199.858, -125.015, 0]} rotation={[0, 0, Math.PI]}>
                <mesh ref={(el) => (sphereRefs.current[1] = el)} castShadow receiveShadow geometry={nodes.Sphere_1.geometry} material={sphereMaterial} position={[-400.206, 0, 0]} rotation={[-Math.PI / 2, 0, 0]} />
              </group>
              <group position={[125.015, -199.858, 0]} rotation={[0, 0, -Math.PI / 2]}>
                <mesh ref={(el) => (sphereRefs.current[2] = el)} castShadow receiveShadow geometry={nodes.Sphere_2.geometry} material={sphereMaterial} position={[-400.206, 0, 0]} rotation={[-Math.PI / 2, 0, 0]} />
              </group>
              <group position={[199.858, 125.015, 0]}>
                <mesh ref={(el) => (sphereRefs.current[3] = el)} castShadow receiveShadow geometry={nodes.Sphere_3.geometry} material={sphereMaterial} position={[-400.206, 0, 0]} rotation={[-Math.PI / 2, 0, 0]} />
              </group>
            </group>
            <group rotation={[-Math.PI / 2, 0, 0]}>
              <group position={[-125.015, 199.858, 0]} rotation={[0, 0, Math.PI / 2]}>
                <mesh ref={(el) => (sphereRefs.current[4] = el)} castShadow receiveShadow geometry={nodes.Sphere_4.geometry} material={sphereMaterial} position={[-400.206, 0, 0]} rotation={[-Math.PI / 2, 0, 0]} />
              </group>
              <group position={[-199.858, -125.015, 0]} rotation={[0, 0, Math.PI]}>
                <mesh ref={(el) => (sphereRefs.current[5] = el)} castShadow receiveShadow geometry={nodes.Sphere_5.geometry} material={sphereMaterial} position={[-400.206, 0, 0]} rotation={[-Math.PI / 2, 0, 0]} />
              </group>
              <group position={[125.015, -199.858, 0]} rotation={[0, 0, -Math.PI / 2]}>
                <mesh ref={(el) => (sphereRefs.current[6] = el)} castShadow receiveShadow geometry={nodes.Sphere_6.geometry} material={sphereMaterial} position={[-400.206, 0, 0]} rotation={[-Math.PI / 2, 0, 0]} />
              </group>
              <group position={[199.858, 125.015, 0]}>
                <mesh ref={(el) => (sphereRefs.current[7] = el)} castShadow receiveShadow geometry={nodes.Sphere_7.geometry} material={sphereMaterial} position={[-400.206, 0, 0]} rotation={[-Math.PI / 2, 0, 0]} />
              </group>
            </group>
            <group position={[-0.038, 0.079, 0.027]} rotation={[-Math.PI / 4, 0, Math.PI / 2]} scale={0.995}>
              <group rotation={[-Math.PI, Math.PI / 4, -Math.PI]}>
                <group position={[77, 77, -77]} rotation={[Math.PI / 2, 0, Math.PI / 2]}>
                  <mesh castShadow receiveShadow geometry={nodes.Cube_1.geometry} material={cubeMaterial} />
                  <mesh castShadow receiveShadow geometry={nodes.Cube_2.geometry} material={cubeMaterial} position={[0, 0, 154]} />
                  <mesh castShadow receiveShadow geometry={nodes.Cube_3.geometry} material={cubeMaterial} position={[0, 154, 0]} />
                  <mesh castShadow receiveShadow geometry={nodes.Cube_4.geometry} material={cubeMaterial} position={[0, 154, 154]} />
                  <mesh castShadow receiveShadow geometry={nodes.Cube_5.geometry} material={cubeMaterial} position={[154, 0, 0]} />
                  <mesh castShadow receiveShadow geometry={nodes.Cube_6.geometry} material={cubeMaterial} position={[154, 0, 154]} />
                  <mesh castShadow receiveShadow geometry={nodes.Cube_7.geometry} material={cubeMaterial} position={[154, 154, 0]} />
                  <mesh castShadow receiveShadow geometry={nodes.Cube_8.geometry} material={cubeMaterial} position={[154, 154, 154]} />
                </group>
              </group>
            </group>
            <group position={[-125.015, 199.858, 0]} rotation={[0, 0, Math.PI / 2]}>
              <mesh ref={(el) => (sphereRefs.current[8] = el)} castShadow receiveShadow geometry={nodes.Sphere_8.geometry} material={sphereMaterial} position={[-400.206, 0, 0]} rotation={[-Math.PI / 2, 0, 0]} />
            </group>
            <group position={[-199.858, -125.015, 0]} rotation={[0, 0, Math.PI]}>
